# Address of the mesh relay (server/mesh-server.ts, default port 3001).
#
# Leave unset for desktop development — the client derives it from the page host.
#
# REQUIRED for the Android build: the APK runs from a local origin inside the
# phone, so it cannot derive the relay address. Point this at the LAN IP of the
# machine running `npm run server`, then rebuild:
#
#   NEXT_PUBLIC_MESH_URL=http://192.168.1.20:3001
#
# For the Android build, also run `npm run android:network-config` before
# `npx cap sync android`: it allows plain HTTP to exactly this host (and the
# reporting host below) and nothing else.
NEXT_PUBLIC_MESH_URL=

# "http" when NEXT_PUBLIC_MESH_URL is the hosted relay (server/relay/vercel.ts),
# which has no websockets: devices then poll it every 10 seconds. Leave unset
# for the local relay, which pushes changes over a websocket at once.
NEXT_PUBLIC_MESH_TRANSPORT=

# Address of the district reporting service (backend/, default port 8000).
#
# This is the record store: patient-record upload, the pre-arrival board at
# /incoming, and the cloud column of the Data Inspector at /data. Leave unset
# for desktop development — the client derives it from the page host, exactly
# as it does for the mesh relay above.
#
# Set it when the backend lives somewhere else — the Android build, or a LAN
# demo where the device is not the machine running uvicorn:
#
#   NEXT_PUBLIC_REPORTING_URL=http://192.168.1.20:8000
#
# This service accepts only the session token the relay issues when a staff
# member signs in with their PIN (backend/app/access.py verifies it with
# NALAMMESH_AUTH_SECRET, below). It serves identified patient records, so it
# still belongs on a trusted network. Do not point this at a public host.
#
# With nothing reachable, every screen that reads the cloud says so — none of
# them fall back to showing an empty store as though it were an answer.
NEXT_PUBLIC_REPORTING_URL=

# Address of the cloud assistant (Layer 2 of the chat widget).
#
# Defaults to NEXT_PUBLIC_REPORTING_URL, because one FastAPI process serves both
# in the single-machine demo. It exists separately for the deployed build: the
# assistant holds nothing but an API key, so it can live on a public HTTPS URL,
# and it has to, since a browser will not let an HTTPS page call a plain-HTTP
# backend. The record store above stays on the LAN.
#
#   NEXT_PUBLIC_CHAT_URL=https://nalammesh-assistant.vercel.app
#
# Unset and unreachable, the assistant still answers offline from the app's own
# protocol data; only the cloud fallback goes quiet.
NEXT_PUBLIC_CHAT_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Server-side settings — the mesh relay (npm run server / scripts/build-relay-deploy.sh)
# and the district service. Never NEXT_PUBLIC_: these are secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Signs staff session tokens (server/relay/auth.ts); the district service
# verifies them with the same value. 32+ random characters, e.g.
#   openssl rand -base64 36
# Unset on a developer machine, the relay and the district service share one
# generated into .nalammesh-dev-secret (git-ignored). A hosted relay must set it.
NALAMMESH_AUTH_SECRET=

# Hosted relay state (Vercel Marketplace: Upstash for Redis). Either pair works.
# Unset, the relay keeps state in memory — fine for one local process only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ABHA verification for citizens (server/relay/abha.ts), from the ABDM sandbox
# integrator portal. Unset, the citizen page says ABHA verification is not
# configured — it never pretends to verify.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# ABDM_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
# ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api

# Bhashini speech recognition and translation for staff (server/relay/bhashini.ts):
# userID and ulcaApiKey from "My Profile" on bhashini.gov.in/ulca, and the
# pipeline id from a pipeline search. Unset, voice input falls back to the
# browser's recogniser and the Translate control is hidden.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=

# Only for refreshing lib/data/official/rhs.json (npm run fetch:rhs). Unset,
# the script uses data.gov.in's public sample key, which is rate-limited.
DATA_GOV_IN_API_KEY=
