{
  "name": "nalammesh-dpi",
  "version": "1.0.0",
  "description": "Enterprise-Grade Digital Public Infrastructure for zero-downtime medical data exchange",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:full": "npm run server & next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mts --max-warnings 0",
    "typecheck": "tsc --noEmit -p .",
    "verify": "node scripts/verify-all.mjs",
    "server": "tsx server/mesh-server.ts",
    "verify:triage": "tsx scripts/verify-triage.mts",
    "verify:metrics": "tsx scripts/verify-metrics.mts",
    "verify:services": "tsx scripts/verify-services.mts",
    "verify:chat-thresholds": "tsx scripts/verify-chat-thresholds.mts",
    "verify:chat-safety": "tsx scripts/verify-chat-safety.mts",
    "verify:chat-retrieval": "tsx scripts/verify-chat-retrieval.mts",
    "verify:chat-render": "tsx scripts/verify-chat-render.mts",
    "verify:chat-scope": "tsx scripts/verify-chat-scope.mts",
    "cap:sync": "next build && tsx scripts/android-network-config.mts && npx cap sync",
    "cap:open": "npx cap open android",
    "apk": "bash scripts/build-apk.sh",
    "verify:cloud-records": "tsx scripts/verify-cloud-records.mts",
    "verify:records-api": "python3 backend/scripts/verify_records.py",
    "verify:store-api": "python3 backend/scripts/verify_store_dump.py",
    "verify:chat-provider": "cd backend && python3 scripts/verify_chat_provider.py",
    "verify:equipment": "tsx scripts/verify-equipment.mts",
    "verify:permissions": "tsx scripts/verify-permissions.mts",
    "verify:referral-flow": "tsx scripts/verify-referral-flow.mts",
    "verify:capacity": "tsx scripts/verify-capacity.mts",
    "verify:relay": "tsx scripts/verify-relay-rbac.mts",
    "verify:db-upgrade": "tsx scripts/verify-db-upgrade.mts",
    "verify:place-names": "tsx scripts/verify-place-names.mts",
    "verify:outbox": "tsx scripts/verify-outbox.mts",
    "verify:icons": "tsx scripts/verify-icons.mts",
    "verify:csp": "tsx scripts/verify-csp.mts",
    "verify:intake": "tsx scripts/verify-intake.mts",
    "verify:queue-tokens": "tsx scripts/verify-queue-tokens.mts",
    "verify:production-mode": "tsx scripts/verify-production-mode.mts",
    "verify:followup": "tsx scripts/verify-followup.mts",
    "verify:abha": "tsx scripts/verify-abha.mts",
    "verify:bhashini": "tsx scripts/verify-bhashini.mts",
    "verify:official-data": "tsx scripts/verify-official-data.mts",
    "fetch:rhs": "tsx scripts/fetch-rhs.mts",
    "android:network-config": "tsx scripts/android-network-config.mts",
    "export:permissions": "tsx scripts/export-permissions.mts",
    "verify:access-api": "cd backend && python3 scripts/verify_access.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@tensorflow/tfjs": "^4.10.0",
    "@upstash/redis": "^1.39.0",
    "express": "^4.18.0",
    "framer-motion": "^11.0.0",
    "idb": "^7.1.1",
    "leaflet": "^1.9.4",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.1",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.26"
    },
    "@tensorflow/tfjs": {
      "argparse": "^2.0.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
