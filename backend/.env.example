# ── District Reporting Service — environment ────────────────────────────────
#
# Every value here is optional. With none of them set the service runs exactly
# as it does in the offline demo: SQLite on disk, no cloud assistant, CORS open
# to the LAN. Clinical care never depends on this service being configured.

# Database. Defaults to a local SQLite file (./district.db).
# For a cloud deploy point this at managed Postgres — SQLModel handles the rest,
# no code change — and uncomment psycopg in requirements.txt:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nalammesh
DATABASE_URL=

# Session tokens. The mesh relay signs a token when staff sign in with their
# PIN; this service verifies it on every record and analytics route (and, with
# CHAT_REQUIRE_SIGN_IN, on the assistant). Set the SAME value as the relay's
# NALAMMESH_AUTH_SECRET — 32 or more random characters, e.g. from
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# On a developer machine both read .nalammesh-dev-secret at the repository root
# instead, so this can stay empty there.
NALAMMESH_AUTH_SECRET=

# ── Cloud chat assistant (Layer 2 of the in-app assistant) ──────────────────
# Four providers are supported and only one is needed. With none set,
# POST /api/v1/chat returns 503 and the app falls back to its offline protocol
# answers — which still cover every clinical question the assistant knows.
# Never commit a real key: set it in the host's secret store, or export it in
# the shell that starts uvicorn.

# Copy this file to backend/.env and fill in one provider. backend/.env is
# git-ignored and is read automatically at startup (python-dotenv).

# A model the department hosts itself — any OpenAI-compatible server (vLLM,
# Ollama, TGI) on a State Data Centre or an empanelled cloud. Questions then
# never leave the department's own infrastructure, which is what a government
# deployment should use. Takes precedence over the third-party keys below.
#   CHAT_BASE_URL=http://10.20.0.5:8000/v1
#   CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
CHAT_BASE_URL=
CHAT_MODEL=
# Optional: only if the server requires a key.
CHAT_API_KEY=

# The three below are third-party services outside the department's own
# infrastructure. Phone, Aadhaar and ABHA numbers are removed from questions
# before they are sent, but the department should still decide whether its
# data-protection rules allow them.

# Groq — api.groq.com. Keys look like gsk_...
#   GROQ_API_KEY=gsk_...
GROQ_API_KEY=
# Optional model override. Default: openai/gpt-oss-120b
# Other chat models on Groq: openai/gpt-oss-20b (faster), qwen/qwen3.8-27b
GROQ_MODEL=
# Optional endpoint override. Default: https://api.groq.com/openai/v1
GROQ_BASE_URL=

# Grok — xAI, api.x.ai. Keys look like xai-... This is a DIFFERENT service from
# Groq above, despite the name. GROK_API_KEY is accepted as an alias.
XAI_API_KEY=
# Optional model override. Default: grok-4
XAI_MODEL=
# Optional endpoint override, e.g. for a proxy. Default: https://api.x.ai/v1
XAI_BASE_URL=

# Claude (Anthropic).
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# Which provider answers when several are set:
#   self-hosted | groq | grok | anthropic | auto
# "auto" (the default) prefers a self-hosted model, then Groq, Grok and Claude.
CHAT_PROVIDER=

# Seconds to wait for the model, and the answer length cap.
# Defaults: 40 and 700. The browser aborts at 45s, so keep this below that.
CHAT_TIMEOUT_S=
CHAT_MAX_TOKENS=

# Abuse limits for the assistant, which visitors can reach without signing in.
# Per caller (a signed-in user, or a network address) per minute and per day,
# and a ceiling for the whole process per day. 0 switches a limit off.
# Defaults: 10, 200, 5000. Also set a monthly spending cap on the provider
# account itself — that is the only limit that holds across restarts.
CHAT_RATE_PER_MINUTE=
CHAT_RATE_PER_DAY=
CHAT_GLOBAL_PER_DAY=
# true: the cloud layer answers signed-in staff only (needs
# NALAMMESH_AUTH_SECRET); visitors still get every offline answer.
CHAT_REQUIRE_SIGN_IN=
# Only when a proxy in front overwrites this header with the caller's address
# (Vercel does for x-real-ip, and the assistant deploy uses it automatically
# there). Otherwise leave empty: the TCP peer is used, and a header the caller
# controls would let every request claim a new address.
CHAT_CLIENT_IP_HEADER=
# Longest grounding brief accepted, in characters. Default 32000; the app's
# brief is about 8,300 for a seven-facility district.
CHAT_MAX_CONTEXT_CHARS=

# Comma-separated list of allowed browser origins. Default "*" is fine on a LAN;
# narrow it to the deployed frontend origin(s) on a public host:
#   CORS_ORIGINS=https://nalammesh.example.gov.in
CORS_ORIGINS=
