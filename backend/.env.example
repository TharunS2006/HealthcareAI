# ── District Reporting Service — environment ────────────────────────────────
#
# Every value here is optional. With none of them set the service runs exactly
# as it does in the offline demo: SQLite on disk, no cloud assistant, CORS open
# to the LAN. Clinical care never depends on this service being configured.

# Database. Defaults to a local SQLite file (./district.db).
# For a cloud deploy point this at managed Postgres — SQLModel handles the rest,
# no code change — and uncomment psycopg in requirements.txt:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nalammesh
DATABASE_URL=

# ── Cloud chat assistant (Layer 2 of the in-app assistant) ──────────────────
# Two providers are supported and only one key is needed. With neither set,
# POST /api/v1/chat returns 503 and the app falls back to its offline protocol
# answers — which still cover every clinical question the assistant knows.
# Never commit a real key: set it in the host's secret store, or export it in
# the shell that starts uvicorn.

# Copy this file to backend/.env and fill in one key. backend/.env is
# git-ignored and is read automatically at startup (python-dotenv).

# Groq — api.groq.com. Keys look like gsk_...
#   GROQ_API_KEY=gsk_...
GROQ_API_KEY=
# Optional model override. Default: openai/gpt-oss-120b
# Other chat models on Groq: openai/gpt-oss-20b (faster), qwen/qwen3.8-27b
GROQ_MODEL=
# Optional endpoint override. Default: https://api.groq.com/openai/v1
GROQ_BASE_URL=

# Grok — xAI, api.x.ai. Keys look like xai-... This is a DIFFERENT service from
# Groq above, despite the name. GROK_API_KEY is accepted as an alias.
XAI_API_KEY=
# Optional model override. Default: grok-4
XAI_MODEL=
# Optional endpoint override, e.g. for a proxy. Default: https://api.x.ai/v1
XAI_BASE_URL=

# Claude (Anthropic).
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# Which provider answers when several keys are set: groq | grok | anthropic | auto.
# "auto" (the default) prefers Groq, then Grok, then Claude.
CHAT_PROVIDER=

# Seconds to wait for the model, and the answer length cap.
# Defaults: 40 and 700. The browser aborts at 45s, so keep this below that.
CHAT_TIMEOUT_S=
CHAT_MAX_TOKENS=

# Comma-separated list of allowed browser origins. Default "*" is fine on a LAN;
# narrow it to the deployed frontend origin(s) on a public host:
#   CORS_ORIGINS=https://nalammesh.example.gov.in
CORS_ORIGINS=
